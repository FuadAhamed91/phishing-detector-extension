{
  "manifest_version": 3,
  "name": "Phishing Link Detector",
  "version": "1.1.0",
  "description": "Hover any link to see where it really goes, a phishing-risk score and the reasons behind it. Everything runs locally.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
